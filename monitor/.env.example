# ===== Grafana alerting (copy to monitor/.env and fill in) =====

# --- Gmail (SMTP) ---
# Use a Google "App password" (Google Account > Security > 2-Step Verification > App passwords),
# not your normal Gmail password.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your.account@gmail.com
GF_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
GF_SMTP_FROM_ADDRESS=your.account@gmail.com
GF_SMTP_FROM_NAME=Shopdee Monitor
# Who receives the alert e-mail (separate multiple with ;)
ALERT_EMAIL_TO=you@example.com

# --- LINE Messaging API (used by the line-notifier service) ---
# LINE Developers console > your provider > Messaging API channel:
#   Channel access token (long-lived)  -> LINE_CHANNEL_ACCESS_TOKEN
#   Your user ID (Basic settings tab) or a groupId the bot is in -> LINE_TO
# Several userIds can be comma-separated (sent with multicast).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
